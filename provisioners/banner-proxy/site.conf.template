<IfModule mod_ssl.c>
    SSLProxyEngine On
</IfModule>

<IfModule mod_headers.c>
    <Location "/assets/json/banner.json">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Location>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{QUERY_STRING} ^expired_after=([^&]+)&published_before=([^&]+)$
    RewriteRule ^/?assets/json/banner\.json$ __API_BASE__/announcements?types=2,3&sort=publish_at&direction=asc&expired_after=%1&published_before=%2 [P,END,NE]

    RewriteRule ^/?assets/json/banner\.json$ __API_BASE__/announcements?types=2,3&sort=publish_at&direction=asc [P,END,NE,QSD]
</IfModule>
